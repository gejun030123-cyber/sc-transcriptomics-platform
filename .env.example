# Copy to .env only when overriding a default.  Do not commit .env.

# Keep project data, SQLite, and temporary analysis/cache files on a writable
# data volume in production.  The defaults are <repo>/data and <repo>/instance.
# DATA_DIR=/srv/sc-platform/data
# DB_PATH=/srv/sc-platform/instance/bioinfo.db
# RUNTIME_TMP_DIR=/srv/sc-platform/runtime_tmp
# MAX_WORKERS=2

# Set these before exposing the service outside a controlled intranet.
# PLATFORM_ACCESS_PASSWORD=replace-with-a-long-random-password
# PLATFORM_ACCESS_SESSION_HOURS=12
# PLATFORM_SESSION_COOKIE_SECURE=true
# CORS_ORIGINS=https://platform.example.org

# Optional AI integration.  Leave all four unset to keep AI chat disabled.
# AI_API_KEY=
# AI_API_URL=https://your-openai-compatible-or-anthropic-endpoint
# AI_MODEL=your-model-name
# AI_API_TOKEN=

# Optional local single-cell resources (never put patient data in these paths).
# SC_CELLTYPIST_MODEL_DIR=/srv/sc-platform/references/celltypist
# A clean clone uses resources/functional_state_resources by default.  Set one
# of these only to use an administrator-maintained replacement snapshot.
# FUNCTIONAL_STATE_RESOURCE_DIR=/srv/sc-platform/references/functional_state
# SC_CELL_GO_GENE_SET_DIR=/srv/sc-platform/references/go_gene_sets
# CELLORACLE_PYTHON=/opt/celloracle/bin/python
# CELLORACLE_HOME_DIR=/srv/sc-platform/cache/celloracle

# Optional server-side batch and WES input roots; use colon-separated paths on Linux.
# SC_BATCH_SOURCE_ROOTS=/srv/sc-input:/mnt/sc-input
# WES_SOURCE_ROOTS=/srv/wes-input
# WES_UPLOAD_ROOT=/srv/sc-platform/wes_uploads

# WES execution stays closed until the complete, validated toolchain and reference
# bundle are installed and registered.  See docs/WES_P2_P3_RUNBOOK.md.
WES_EXECUTOR_ENABLED=false
# WES_NEXTFLOW_BIN=nextflow
# WES_NEXTFLOW_PROFILE=docker
# WES_NEXTFLOW_IGENOMES_BASE=/srv/wes-references/igenomes
# WES_NEXTFLOW_VEP_CACHE=/srv/wes-references/vep_cache
# WES_NEXTFLOW_PON=/srv/wes-references/pon.vcf.gz
# WES_NEXTFLOW_GERMLINE_RESOURCE=/srv/wes-references/af-only-gnomad.vcf.gz
